{
  "name": "yoeldis-castillo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir server && node scripts/finalize-build.mjs && node scripts/check-bundle.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:permissions": "node scripts/test-permissions.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.80.0",
    "@tanstack/react-query": "^5.90.0",
    "@tiptap/extension-image": "^3.10.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
